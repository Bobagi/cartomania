generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameMode {
  CLASSIC
  ATTRIBUTE_DUEL
}

enum DuelStage {
  PICK_CARD
  PICK_ATTRIBUTE
  REVEAL
  RESOLVED
}

enum UserRole {
  USER
  ADMIN
}

model Player {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(50)

  // Password is optional: Google-only accounts have no local password. The DB
  // enforces that an account always has AT LEAST one credential (see the
  // migration's CHECK constraint) so a passwordless, Google-less ghost can't exist.
  passwordHash String?   @db.VarChar(60)
  role         UserRole  @default(USER)
  avatarUrl    String?   @db.VarChar(255)

  // Google / OpenID identity. `googleId` is the stable OIDC `sub`; `email` is the
  // (verified) address. Both are unique-when-present (Postgres treats NULLs as
  // distinct, so many password-only accounts with NULLs never collide).
  email         String?  @unique @db.VarChar(255)
  googleId      String?  @unique @db.VarChar(255)
  emailVerified Boolean  @default(false)

  // Bumped to revoke every outstanding session (password change/reset, unlink).
  // The JWT carries this value; the guard rejects a token whose tv is stale.
  tokenVersion  Int      @default(0)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSeenAt   DateTime?
  gamesAsA     Game[]    @relation("PlayerA")
  gamesAsB     Game[]    @relation("PlayerB")
  sentFriendships     Friendship[]        @relation("FriendshipRequester")
  receivedFriendships Friendship[]        @relation("FriendshipAddressee")
  blockedFriendships  Friendship[]        @relation("FriendshipBlocker")
  sentMessages        FriendChatMessage[] @relation("ChatSender")
  receivedMessages    FriendChatMessage[] @relation("ChatRecipient")
  agreementAcceptances AgreementAcceptance[]
  authTokens           AuthToken[]
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// One-time tokens for email verification and password reset. Only the SHA-256
/// HASH of the token is stored (like a session token); the raw token lives only
/// in the email link. Single-use (usedAt) + time-limited (expiresAt). Requesting
/// a new token of a purpose invalidates the user's prior ones of that purpose.
model AuthToken {
  id         String           @id @default(uuid()) @db.Uuid
  playerId   String           @db.Uuid
  player     Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @db.VarChar(64)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([playerId, purpose])
}

/// Append-only proof that a player accepted the Terms of Use + Privacy Policy.
/// One row per acceptance (who / which document version / when / from where). The
/// version in force is CURRENT_AGREEMENT_VERSION; bumping it makes every prior row
/// stop matching, so the gate forces everyone to re-accept. IP + user agent are
/// PII, erased by the cascade when the account is hard-deleted.
model AgreementAcceptance {
  id              String   @id @default(uuid()) @db.Uuid
  playerId        String   @db.Uuid
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  documentVersion String   @db.VarChar(40)
  ipAddress       String?  @db.VarChar(64)
  userAgent       String?  @db.VarChar(512)
  acceptedAt      DateTime @default(now())

  @@index([playerId, documentVersion])
}

model Game {
  id        String   @id @default(uuid()) @db.Uuid

  playerAId String   @db.Uuid
  playerBId String   @db.Uuid
  playerA   Player   @relation("PlayerA", fields: [playerAId], references: [id])
  playerB   Player   @relation("PlayerB", fields: [playerBId], references: [id])

  turn      Int
  hp        Json
  winner    String?  @db.VarChar(50)
  hands     Json
  decks     Json
  log       Json

  mode        GameMode   @default(CLASSIC)
  duelStage   DuelStage?
  duelCenter  Json?
  discardPiles Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id           String            @id @default(uuid()) @db.Uuid
  requesterId  String            @db.Uuid
  addresseeId  String            @db.Uuid
  status       FriendshipStatus  @default(PENDING)
  blockedById  String?           @db.Uuid
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  requester    Player            @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addressee    Player            @relation("FriendshipAddressee", fields: [addresseeId], references: [id])
  blockedBy    Player?           @relation("FriendshipBlocker", fields: [blockedById], references: [id])
  messages     FriendChatMessage[]

  @@unique([requesterId, addresseeId])
}

model FriendChatMessage {
  id           String   @id @default(uuid()) @db.Uuid
  friendshipId String   @db.Uuid
  senderId     String   @db.Uuid
  recipientId  String   @db.Uuid
  body         String   @db.VarChar(1000)
  createdAt    DateTime @default(now())

  friendship   Friendship @relation(fields: [friendshipId], references: [id])
  sender       Player     @relation("ChatSender", fields: [senderId], references: [id])
  recipient    Player     @relation("ChatRecipient", fields: [recipientId], references: [id])

  @@index([friendshipId, createdAt])
}

model Card {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String   @db.VarChar(1000)
  number      Int      @default(0)
  damage      Int?
  heal        Int?
  imageUrl    String   @db.VarChar(255)
  might       Int      @default(0)
  fire        Int      @default(0)
  magic       Int      @default(0)
  collectionId String   @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id])
  translations CardTranslation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Localized name/description for a Card. The base Card row keeps the canonical
/// (English) text; one row here per (card, locale) for each translated language.
model CardTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  cardId      String   @db.Uuid
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  locale      String   @db.VarChar(8)
  name        String   @db.VarChar(150)
  description String   @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([cardId, locale])
}

model CardTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(150)
  frameUrl   String   @db.VarChar(255)
  fontColor  String   @db.VarChar(30)
  rarity     String   @db.VarChar(30)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Collection {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(150)
  name         String   @db.VarChar(150)
  description  String?  @db.VarChar(1000)
  manufacturer String?  @db.VarChar(150)
  releaseDate  DateTime?
  totalCards   Int?
  imageUrl     String?  @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cards        Card[]
}
